```gitignore
# Environment
.env
.venv/
venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Django
*.log
db.sqlite3
db.sqlite3-journal
media/

# PyCharm / IntelliJ
.idea/

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Testing / Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Build / Distribution
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Type checking
.mypy_cache/
.pyre/
.pytype/

# Ruff
.ruff_cache/

# Temporary / backup files
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig

# Local configuration
local_settings.py
```
